[gd_scene format=3 uid="uid://cwdo843ny1dil"]

[ext_resource type="Texture2D" uid="uid://b6blsdmu7tu40" path="res://ui/certificate_bg.png" id="1_t4o6v"]

[sub_resource type="GDScript" id="GDScript_xrivr"]
resource_name = "res://scripts/Certificate.gd"
script/source = "extends Control

@onready var player_name: Label = $PlayerName
@onready var date_label: Label = $DateLabel
@onready var save_button: Button = $SaveButton
@onready var menu_button: Button = $MenuButton

func _ready() -> void:
	player_name.text = GameState.player_name

	var time := Time.get_datetime_dict_from_system()
	date_label.text = \"%02d.%02d.%d\" % [time[\"day\"], time[\"month\"], time[\"year\"]]

	save_button.pressed.connect(_on_save)
	menu_button.pressed.connect(_on_menu)

func _on_save() -> void:
	
	save_button.visible = false
	menu_button.visible = false

	await RenderingServer.frame_post_draw

	var image := get_viewport().get_texture().get_image()

	var dialog := FileDialog.new()
	dialog.file_mode = FileDialog.FILE_MODE_SAVE_FILE
	dialog.access = FileDialog.ACCESS_FILESYSTEM
	dialog.add_filter(\"*.png\", \"PNG изображение\")
	dialog.current_file = \"certificate.png\"
	dialog.size = Vector2i(700, 500)
	dialog.use_native_dialog = true
	add_child(dialog)

	dialog.file_selected.connect(func(path: String):
		var result := image.save_png(path)
		if result == OK:
			print(\"Сертификат сохранён: \", path)
		else:
			print(\"Ошибка сохранения: \", result)
		save_button.visible = true
		menu_button.visible = true
		dialog.queue_free()
	)

	dialog.canceled.connect(func():
		save_button.visible = true
		menu_button.visible = true
		dialog.queue_free()
	)

	dialog.popup_centered()

func _on_menu() -> void:
	GameState.reset()
	SceneManager.go_to_menu()
"

